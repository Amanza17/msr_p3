<robot xmlns:xacro="http://wiki.ros.org/xacro" name="rover">
<!--  includes  -->
<xacro:include filename="$(find rover_description)/urdf/base/base.urdf.xacro"/>
<xacro:include filename="$(find rover_description)/urdf/wheels/wheels.urdf.xacro"/>
<xacro:include filename="$(find rover_description)/urdf/arm/scara.urdf.xacro"/>

<xacro:include filename="$(find rover_description)/urdf/sensors/camera.urdf.xacro"/> 
<xacro:include filename="$(find rover_description)/urdf/sensors/imu_sensor.urdf.xacro"/>
 
<!--  MAteriales  -->

  <material name="Material.004">
    <color rgba="0.01569 0.01569 0.01569 1.0"/>
  </material>

  <material name="Material.006">
    <color rgba="0.64314 0.61176 0.61176 1.0"/>
  </material>

  <material name="Material.008">
    <color rgba="0.0 0.0 0.8 1.0"/>
  </material>

  <material name="Material.009">
    <color rgba="0.25098 0.25098 0.25098 1.0"/>
  </material>

  <material name="Material.010">
    <color rgba="0.8 0.00392 0.00784 1.0"/>
  </material>

<xacro:property name="PI" value="3.1415926535897931"/>


<!--
<xacro:property name="wheel_offset_x" value="0.95"/>
<xacro:property name="wheel_offset_y" value="0.95"/>
<xacro:property name="wheel_offset_z" value="-0.38"/>
<xacro:property name="arm_offset_x" value="0.0"/>
<xacro:property name="arm_offset_y" value="0.82"/>
<xacro:property name="arm_offset_z" value="0.69"/>
 -->
<!--  argumentos  -->
<xacro:arg name="robot_ns" default=""/>
<xacro:arg name="prefix" default=""/>
<!--  Robot Parts  -->

<xacro:base/>
<xacro:scara parent="base_link"/>
<xacro:wheels parent="base_link"/>



<!--  sensores  -->

<xacro:sensor_camera node_name="front_camera" node_namespace="$(arg robot_ns)" frame_prefix="$(arg prefix)front_camera_" parent="$(arg prefix)base_link">
<origin xyz="1.4 0 0.5" rpy="0 0 0"/>
</xacro:sensor_camera>


<xacro:sensor_camera node_name="arm_camera" node_namespace="$(arg robot_ns)" frame_prefix="$(arg prefix)arm_camera_" parent="$(arg prefix)pinza_base_link" >
    <origin xyz="0.0 0.0 -0.01" rpy="0 1.57 0"/>
</xacro:sensor_camera> 
<xacro:sensor_imu ns="$(arg robot_ns)" prefix="$(arg prefix)imu_" parent="$(arg prefix)base_link">
    <origin xyz="0.0 0.0 0.0" rpy="0 0 0"/>
</xacro:sensor_imu>
<!--  Gazebo ROS control plugins  -->

<xacro:include filename="$(find rover_description)/urdf/ros2_control.urdf.xacro"/>
<xacro:arg name="config_controllers" default="$(find rover_description)/config/rover_controllers.yaml"/>
<xacro:arg name="update_rate" default="100"/>
<xacro:ros2_control/>
</robot>